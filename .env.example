# MCP Server Configuration
# 复制此文件为 .env 并根据需要修改配置

# MCP服务器端口 (MCPStandalone对外提供的SSE服务端口)
MCP_PORT=8099

# MCP服务器监听地址
MCP_HOST=127.0.0.1

# 编辑器转发服务器端口 (UE编辑器内部监听的端口)
EDITOR_PORT=8100

# 编辑器转发服务器地址
EDITOR_HOST=127.0.0.1

# 单实例模式（默认 false，允许多个 MCPStandalone 实例同时运行）
# 设置为 true 时，只允许一个 MCPStandalone 实例运行（向前兼容）
MCP_SINGLE_INSTANCE=false

# 项目 .uproject 绝对路径（启用 open_editor / close_editor 工具）
# 不配置则不暴露这两个工具，仅保留 execute_command / excute_file / get_editor_state
# 示例: EDITOR_PROJECT=E:\UE5Projects\LuaToBPVM\LuaToBPVM.uproject
EDITOR_PROJECT=

# ──────────────────────────────────────────────────────────────────────────────
# open_editor / close_editor 内部超时（对 AI 不暴露，仅 server 内部使用）
# 不需要时保持注释，使用默认值即可
# ──────────────────────────────────────────────────────────────────────────────

# 命中插件就绪信号（ModularStartUp / Python MCP 可用）后，再等待多久让编辑器稳定（秒）
# OPEN_SETTLE_SECONDS=20

# 未命中就绪信号时的最大等待时长（秒）
# OPEN_READY_TIMEOUT=600

# 构建日志无新输出多久视为卡死（秒）。编译时间不固定，因此用 idle 心跳取代固定总超时
# COMPILE_IDLE_TIMEOUT=120

# 编译总耗时绝对上限（秒），覆盖全量编译。默认 2 小时
# COMPILE_MAX_SECONDS=7200

# close_editor 优雅关闭等待时长（秒），超时后强杀
# CLOSE_GRACEFUL_TIMEOUT=120
